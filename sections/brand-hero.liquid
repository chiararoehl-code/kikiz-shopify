{%- comment -%}
  Video-first hero. The cookie is the hero, not the text: eyebrow +
  optional headline + one CTA sit in a small legibility scrim over a
  full-bleed, muted/looping/autoplaying video.

  Shopify-native video only — the `video` setting type + `video_tag`
  filter render a real <video> with Shopify's own transcoded sources, no
  YouTube/Vimeo/external player JS. `video_tag`'s `image_size` controls
  the resolution of the video's own auto-generated first-frame image
  (used as its native poster) — that's a documented, certain mechanism.
  There is no documented way to hand video_tag a fully custom poster
  image, so `poster_image` here is deliberately used only for the
  no-video-configured fallback path, never claimed as a video poster
  override.

  An optional separate mobile video is supported because video sources
  don't adapt to viewport the way <img srcset> does — video_tag can't
  merge two Shopify video objects into one <video>'s source list, so
  when both exist, two full <video> elements exist in the DOM and CSS
  shows only one per breakpoint (assets/hero-video.js documents the one
  behavioral trade-off this causes: browsers may fetch metadata for
  both).
{%- endcomment -%}

<section class="hero-video color-scheme--{{ section.settings.color_scheme }}" data-hero-video>
  <div class="hero-video__media">
    {%- if section.settings.video != blank -%}
      <div class="hero-video__player hero-video__player--desktop">
        {{ section.settings.video | video_tag: image_size: '1600x', autoplay: true, loop: true, muted: true, playsinline: true, controls: false, class: 'hero-video__el' }}
      </div>
    {%- endif -%}

    {%- if section.settings.video_mobile != blank -%}
      <div class="hero-video__player hero-video__player--mobile">
        {{ section.settings.video_mobile | video_tag: image_size: '1000x', autoplay: true, loop: true, muted: true, playsinline: true, controls: false, class: 'hero-video__el' }}
      </div>
    {%- endif -%}

    {%- if section.settings.video == blank -%}
      {%- if section.settings.poster_image != blank -%}
        <img
          class="hero-video__fallback-image"
          src="{{ section.settings.poster_image | image_url: width: 1600 }}"
          srcset="
            {{ section.settings.poster_image | image_url: width: 750 }} 750w,
            {{ section.settings.poster_image | image_url: width: 1100 }} 1100w,
            {{ section.settings.poster_image | image_url: width: 1600 }} 1600w
          "
          sizes="100vw"
          width="{{ section.settings.poster_image.width }}"
          height="{{ section.settings.poster_image.height }}"
          alt=""
          loading="eager"
          fetchpriority="high"
        >
      {%- else -%}
        <div class="hero-video__fallback-panel" aria-hidden="true"></div>
      {%- endif -%}
    {%- endif -%}
  </div>

  <div class="hero-video__content">
    {%- if section.settings.eyebrow != blank -%}
      <p class="hero-video__eyebrow label">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h1 class="hero-video__heading display-l">{{ section.settings.heading }}</h1>
    {%- endif -%}
    {%- if section.settings.primary_cta_label != blank -%}
      <a
        href="{{ section.settings.primary_cta_link | default: '#box-selector' }}"
        class="btn btn--primary hero-video__cta"
      >
        {{ section.settings.primary_cta_label }}
      </a>
    {%- endif -%}
  </div>
</section>

{{ 'hero-video.js' | asset_url | script_tag }}

{% schema %}
{
  "name": "Video hero",
  "settings": [
    {
      "type": "header",
      "content": "Video"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Desktop video",
      "info": "Close-up cookie footage. Muted, looping, autoplaying."
    },
    {
      "type": "video",
      "id": "video_mobile",
      "label": "Mobile video (optional)",
      "info": "Falls back to the desktop video on small screens if left empty."
    },
    {
      "type": "image_picker",
      "id": "poster_image",
      "label": "Fallback image",
      "info": "Shown only if no desktop video is set yet."
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "FRESHLY BAKED IN BASEL"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Headline",
      "info": "Keep it short — the video is the hero, not the text."
    },
    {
      "type": "text",
      "id": "primary_cta_label",
      "label": "Button label",
      "default": "JETZT BESTELLEN"
    },
    {
      "type": "url",
      "id": "primary_cta_link",
      "label": "Button link",
      "info": "Defaults to the Box Selector (#box-selector) when left empty."
    },
    {
      "type": "header",
      "content": "Color"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "cream", "label": "Cream / Near black text" },
        { "value": "mango", "label": "Mango / Near black text" },
        { "value": "black", "label": "Near black / Cream text" },
        { "value": "chrome", "label": "Chrome / Near black text" }
      ],
      "default": "black"
    }
  ],
  "presets": [
    {
      "name": "Video hero"
    }
  ]
}
{% endschema %}
