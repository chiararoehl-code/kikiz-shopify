{%- if section.settings.enable -%}
  <div
    class="announcement-bar color-scheme--{{ section.settings.color_scheme }}"
    role="region"
    aria-label="{{ 'sections.announcement_bar.label' | t }}"
  >
    <div class="announcement-bar__inner container">
      {%- if section.settings.link != blank -%}
        <a href="{{ section.settings.link }}" class="announcement-bar__link">
          <p class="announcement-bar__text">{{ section.settings.text }}</p>
        </a>
      {%- else -%}
        <p class="announcement-bar__text">{{ section.settings.text }}</p>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable",
      "label": "Enable announcement bar",
      "default": true
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "THIS WEEK'S DROP IS LIVE"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link",
      "info": "Optional. Makes the whole bar clickable."
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "mango", "label": "Mango / Near black text" },
        { "value": "black", "label": "Near black / Cream text" },
        { "value": "cream", "label": "Cream / Near black text" },
        { "value": "chrome", "label": "Chrome / Near black text" }
      ],
      "default": "mango"
    }
  ],
  "presets": [
    {
      "name": "Announcement bar"
    }
  ]
}
{% endschema %}
