{%- if section.settings.enable -%}
  <div
    class="announcement-bar color-scheme--{{ section.settings.color_scheme }}"
    role="region"
    aria-label="{{ 'sections.announcement_bar.label' | t }}"
  >
    <div class="announcement-bar__inner container">
      {%- if section.settings.link != blank -%}
        <a href="{{ section.settings.link }}" class="announcement-bar__link">
          <p class="announcement-bar__text">{{ section.settings.text }}</p>
        </a>
      {%- else -%}
        <p class="announcement-bar__text">{{ section.settings.text }}</p>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable",
      "label": "Enable announcement bar",
      "default": true
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "THIS WEEK'S DROP IS LIVE"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link",
      "info": "Optional. Makes the whole bar clickable."
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "green-dark", "label": "Deep green / Lavender text" },
        { "value": "green", "label": "Green / Lavender text" },
        { "value": "lavender", "label": "Lavender / Deep green text" },
        { "value": "off-white", "label": "Off white / Deep green text" }
      ],
      "default": "green-dark"
    }
  ],
  "presets": [
    {
      "name": "Announcement bar"
    }
  ]
}
{% endschema %}
