<section class="weekly-drop color-scheme--{{ section.settings.color_scheme }}">
  {%- if section.settings.collection == blank -%}
    {%- if request.design_mode -%}
      <div class="weekly-drop__placeholder container">
        <p>{{ 'sections.weekly_drop.placeholder' | t }}</p>
      </div>
    {%- endif -%}
  {%- elsif section.settings.collection.products.size == 0 -%}
    <div class="weekly-drop__header container">
      {%- if section.settings.eyebrow != blank -%}
        <p class="label">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="weekly-drop__heading display-l">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>
    <div class="weekly-drop__empty container">
      <p>{{ 'sections.weekly_drop.empty' | t }}</p>
    </div>
  {%- else -%}
    <div class="weekly-drop__header container">
      <div class="weekly-drop__heading-group">
        {%- if section.settings.eyebrow != blank -%}
          <p class="label">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="weekly-drop__heading display-l">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
      {%- if section.settings.supporting_text != blank -%}
        <p class="weekly-drop__supporting body-lg">{{ section.settings.supporting_text }}</p>
      {%- endif -%}
    </div>

    <ul class="product-rail container" role="list">
      {%- for product in section.settings.collection.products limit: section.settings.product_limit -%}
        <li class="product-rail__item">
          {%- render 'product-card', product: product -%}
        </li>
      {%- endfor -%}
    </ul>

    {%- if section.settings.cta_label != blank -%}
      <div class="weekly-drop__cta container">
        <a href="{{ section.settings.cta_link | default: section.settings.collection.url }}" class="btn btn--secondary">
          {{ section.settings.cta_label }}
        </a>
      </div>
    {%- endif -%}
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Weekly drop",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "FRESH THIS WEEK"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "THIS WEEK'S DROP"
    },
    {
      "type": "text",
      "id": "supporting_text",
      "label": "Supporting text",
      "default": "New flavors. Limited time."
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Number of products",
      "min": 3,
      "max": 8,
      "step": 1,
      "default": 6
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "SEE ALL COOKIES"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link",
      "info": "Optional. Falls back to the collection page."
    },
    {
      "type": "header",
      "content": "Color"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "off-white", "label": "Off white / Deep green text" },
        { "value": "lavender", "label": "Lavender / Deep green text" },
        { "value": "green", "label": "Green / Lavender text" },
        { "value": "green-dark", "label": "Deep green / Lavender text" }
      ],
      "default": "off-white"
    }
  ],
  "presets": [
    {
      "name": "Weekly drop"
    }
  ]
}
{% endschema %}
