{%- liquid
  assign all_flavors = shop.metaobjects.cookie_flavor.values | sort: 'sort_order'
  assign flavor_count = 0
  assign special_count = 0
  assign weekly_special = null

  for flavor in all_flavors
    if flavor.active.value and flavor.available_this_week.value
      assign flavor_count = flavor_count | plus: 1
      assign badge_normalized = flavor.badge.value | strip | upcase
      if badge_normalized == 'WEEKLY SPECIAL'
        assign special_count = special_count | plus: 1
        assign weekly_special = flavor
      endif
    endif
  endfor

  assign show_special_separately = false
  if special_count == 1
    assign show_special_separately = true
  endif

  assign classics_limit = section.settings.flavor_limit
  if show_special_separately
    assign classics_limit = section.settings.flavor_limit | minus: 1
  endif
-%}

<section id="weekly-drop" class="weekly-drop color-scheme--{{ section.settings.color_scheme }}{% if flavor_count == 0 %} weekly-drop--empty{% endif %}">

  <div class="weekly-drop__header container">
    <div class="weekly-drop__heading-group">
      {%- if section.settings.eyebrow != blank -%}
        <p class="label">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="weekly-drop__heading display-l">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>
    {%- if section.settings.supporting_text != blank -%}
      <p class="weekly-drop__supporting body-lg">{{ section.settings.supporting_text }}</p>
    {%- endif -%}
  </div>

  {%- if flavor_count == 0 -%}
    <div class="weekly-drop__empty container">
      <div class="weekly-drop__empty-card">
        <span class="weekly-drop__empty-mark" aria-hidden="true"></span>
        {%- if request.design_mode -%}
          <p class="h3">{{ 'sections.weekly_drop.empty_editor' | t }}</p>
        {%- else -%}
          <p class="h3">{{ 'sections.weekly_drop.empty' | t }}</p>
        {%- endif -%}
      </div>
    </div>
  {%- else -%}
    {%- if show_special_separately -%}
      <div class="weekly-drop__special container">
        {%- render 'cookie-card', flavor: weekly_special, featured: true -%}
      </div>
    {%- endif -%}

    <ul class="product-rail product-rail--classics container" role="list">
      {%- assign shown = 0 -%}
      {%- for flavor in all_flavors -%}
        {%- if flavor.active.value and flavor.available_this_week.value and shown < classics_limit -%}
          {%- unless show_special_separately and flavor.handle == weekly_special.handle -%}
            <li class="product-rail__item">
              {%- render 'cookie-card', flavor: flavor -%}
            </li>
            {%- assign shown = shown | plus: 1 -%}
          {%- endunless -%}
        {%- endif -%}
      {%- endfor -%}
    </ul>

    {%- if section.settings.cta_label != blank -%}
      <div class="weekly-drop__cta container">
        <a href="#box-selector" class="btn btn--primary">
          {{ section.settings.cta_label }}
        </a>
      </div>
    {%- endif -%}
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Weekly drop",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "THIS WEEK'S DROP"
    },
    {
      "type": "text",
      "id": "supporting_text",
      "label": "Supporting text",
      "default": "Nur diese Woche."
    },
    {
      "type": "header",
      "content": "Flavors"
    },
    {
      "type": "range",
      "id": "flavor_limit",
      "label": "Number of flavors to show",
      "min": 3,
      "max": 8,
      "step": 1,
      "default": 5,
      "info": "Includes the weekly special, when one is set (badge = \"WEEKLY SPECIAL\")."
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "BOX BAUEN",
      "info": "Scrolls to the Box Selector section (#box-selector)."
    },
    {
      "type": "header",
      "content": "Color"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "cream", "label": "Cream / Near black text" },
        { "value": "mango", "label": "Mango / Near black text" },
        { "value": "black", "label": "Near black / Cream text" },
        { "value": "chrome", "label": "Chrome / Near black text" }
      ],
      "default": "cream"
    }
  ],
  "presets": [
    {
      "name": "Weekly drop"
    }
  ]
}
{% endschema %}
