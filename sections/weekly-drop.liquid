{%- comment -%}
  Every active, available-this-week flavor renders through the same large
  editorial module (snippets/cookie-card.liquid), alternating image side
  by position — no separate "featured" treatment. The weekly special (if
  the merchant has set one via badge = "WEEKLY SPECIAL") still stands out
  on its own, since cookie-card already renders that badge for whichever
  flavor carries it; it just doesn't get a second, differently-sized card
  system on top of that, per the redesign brief's "don't make this
  visually complicated again."
{%- endcomment -%}

{%- liquid
  assign all_flavors = shop.metaobjects.cookie_flavor.values | sort: 'sort_order'
  assign flavor_count = 0
  for flavor in all_flavors
    if flavor.active.value and flavor.available_this_week.value
      assign flavor_count = flavor_count | plus: 1
    endif
  endfor
-%}

<section id="weekly-drop" class="weekly-drop color-scheme--{{ section.settings.color_scheme }}{% if flavor_count == 0 %} weekly-drop--empty{% endif %}">

  <div class="weekly-drop__header container">
    <div class="weekly-drop__heading-group">
      {%- if section.settings.eyebrow != blank -%}
        <p class="label">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="weekly-drop__heading display-l">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>
    {%- if section.settings.supporting_text != blank -%}
      <p class="weekly-drop__supporting body-lg">{{ section.settings.supporting_text }}</p>
    {%- endif -%}
  </div>

  {%- if flavor_count == 0 -%}
    <div class="weekly-drop__empty container">
      <div class="weekly-drop__empty-card">
        <span class="weekly-drop__empty-mark" aria-hidden="true"></span>
        {%- if request.design_mode -%}
          <p class="h3">{{ 'sections.weekly_drop.empty_editor' | t }}</p>
        {%- else -%}
          <p class="h3">{{ 'sections.weekly_drop.empty' | t }}</p>
        {%- endif -%}
      </div>
    </div>
  {%- else -%}
    <div class="weekly-drop__list container">
      {%- assign shown = 0 -%}
      {%- for flavor in all_flavors -%}
        {%- if flavor.active.value and flavor.available_this_week.value and shown < section.settings.flavor_limit -%}
          {%- assign align = 'left' -%}
          {%- if shown | modulo: 2 == 1 -%}
            {%- assign align = 'right' -%}
          {%- endif -%}
          {%- render 'cookie-card', flavor: flavor, align: align -%}
          {%- assign shown = shown | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Weekly drop",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "THIS WEEK'S DROP"
    },
    {
      "type": "text",
      "id": "supporting_text",
      "label": "Supporting text",
      "default": "Nur diese Woche."
    },
    {
      "type": "header",
      "content": "Flavors"
    },
    {
      "type": "range",
      "id": "flavor_limit",
      "label": "Number of flavors to show",
      "min": 3,
      "max": 8,
      "step": 1,
      "default": 5
    },
    {
      "type": "header",
      "content": "Color"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "cream", "label": "Cream / Near black text" },
        { "value": "mango", "label": "Mango / Near black text" },
        { "value": "black", "label": "Near black / Cream text" },
        { "value": "chrome", "label": "Chrome / Near black text" }
      ],
      "default": "cream"
    }
  ],
  "presets": [
    {
      "name": "Weekly drop"
    }
  ]
}
{% endschema %}
