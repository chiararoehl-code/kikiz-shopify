<section class="weekly-drop color-scheme--{{ section.settings.color_scheme }}">
  {%- liquid
    assign all_flavors = shop.metaobjects.cookie_flavor.values | sort: 'sort_order'
    assign flavor_count = 0
    for flavor in all_flavors
      if flavor.active.value and flavor.available_this_week.value
        assign flavor_count = flavor_count | plus: 1
      endif
    endfor
  -%}

  <div class="weekly-drop__header container">
    <div class="weekly-drop__heading-group">
      {%- if section.settings.eyebrow != blank -%}
        <p class="label">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="weekly-drop__heading display-l">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>
    {%- if section.settings.supporting_text != blank -%}
      <p class="weekly-drop__supporting body-lg">{{ section.settings.supporting_text }}</p>
    {%- endif -%}
  </div>

  {%- if flavor_count == 0 -%}
    <div class="weekly-drop__empty container">
      <p>{{ 'sections.weekly_drop.empty' | t }}</p>
    </div>
  {%- else -%}
    <ul class="product-rail container" role="list">
      {%- assign shown = 0 -%}
      {%- for flavor in all_flavors -%}
        {%- if flavor.active.value and flavor.available_this_week.value and shown < section.settings.flavor_limit -%}
          <li class="product-rail__item">
            {%- render 'cookie-card', flavor: flavor -%}
          </li>
          {%- assign shown = shown | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    </ul>

    {%- if section.settings.cta_label != blank -%}
      <div class="weekly-drop__cta container">
        <a href="#box-selector" class="btn btn--secondary">
          {{ section.settings.cta_label }}
        </a>
      </div>
    {%- endif -%}
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Weekly drop",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "FRESH THIS WEEK"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "THIS WEEK'S DROP"
    },
    {
      "type": "text",
      "id": "supporting_text",
      "label": "Supporting text",
      "default": "New flavors. Limited time."
    },
    {
      "type": "header",
      "content": "Flavors"
    },
    {
      "type": "range",
      "id": "flavor_limit",
      "label": "Number of flavors to show",
      "min": 3,
      "max": 8,
      "step": 1,
      "default": 6
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "BUILD YOUR BOX",
      "info": "Scrolls to the Box Selector section (#box-selector)."
    },
    {
      "type": "header",
      "content": "Color"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "off-white", "label": "Off white / Deep green text" },
        { "value": "lavender", "label": "Lavender / Deep green text" },
        { "value": "green", "label": "Green / Lavender text" },
        { "value": "green-dark", "label": "Deep green / Lavender text" }
      ],
      "default": "off-white"
    }
  ],
  "presets": [
    {
      "name": "Weekly drop"
    }
  ]
}
{% endschema %}
