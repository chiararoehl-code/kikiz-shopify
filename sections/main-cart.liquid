{%- comment -%}
  Cart page. Progressive-enhancement safe: a plain form posting to
  routes.cart_url updates quantities (updates[line.key]) and checks out
  (submit name="checkout") with zero JavaScript required. Each configured
  box stays exactly one Shopify cart line — Shopify's own variant +
  line-item-property matching is what keeps identical boxes merged and
  different flavor configurations separate; nothing here re-implements that.

  Fulfillment (Pickup/Delivery) is a cart-level Shopify attribute, not a
  line item property — it applies to the whole order, not to one box, so it
  is rendered once here rather than per line (see snippets/cart-line-item).
{%- endcomment -%}

{%- assign fulfillment_method = cart.attributes['Fulfillment method'] -%}

<section class="cart-page color-scheme--{{ section.settings.color_scheme }}" id="MainCart">
  <div class="cart-page__header container">
    {%- if section.settings.eyebrow != blank -%}
      <p class="label">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h1 class="cart-page__heading display-l">{{ section.settings.heading }}</h1>
  </div>

  {%- if cart.item_count == 0 -%}
    <div class="cart-page__empty container">
      <div class="cart-page__empty-card">
        <span class="cart-page__empty-mark" aria-hidden="true"></span>
        <h2 class="h2">{{ 'sections.cart.empty_heading' | t }}</h2>
        <p class="body">{{ 'sections.cart.empty_supporting' | t }}</p>
        <a href="{{ routes.root_url }}#box-selector" class="btn btn--primary">
          {{ 'sections.cart.build_box_cta' | t }}
        </a>
      </div>
    </div>
  {%- else -%}
    <form action="{{ routes.cart_url }}" method="post" class="cart-page__form" id="CartForm">
      <div class="cart-page__layout container">
        <div class="cart-page__lines">
          <p class="cart-page__lines-heading label">{{ 'sections.cart.your_cookie_box' | t }}</p>
          <ul class="cart-lines" role="list">
            {%- for item in cart.items -%}
              <li class="cart-line">
                {%- render 'cart-line-item', item: item -%}
              </li>
            {%- endfor -%}
          </ul>
          <button type="submit" name="update" class="btn btn--secondary cart-page__update">
            {{ 'sections.cart.update_cart' | t }}
          </button>
        </div>

        <div class="cart-page__summary">
          <div class="fulfillment-summary">
            <p class="fulfillment-summary__label label">{{ 'sections.cart.fulfillment_label' | t }}</p>
            <div class="fulfillment-summary__row">
              <span
                class="fulfillment-summary__value"
                data-fulfillment-summary
                data-fulfillment-empty-label="{{ 'sections.cart.fulfillment_not_selected' | t }}"
              >
                {%- if fulfillment_method != blank -%}
                  {{ fulfillment_method }}
                {%- else -%}
                  {{ 'sections.cart.fulfillment_not_selected' | t }}
                {%- endif -%}
              </span>
              <button
                type="button"
                class="btn btn--secondary fulfillment-summary__action"
                data-fulfillment-open
                data-fulfillment-choose-label="{{ 'sections.cart.fulfillment_choose' | t }}"
                data-fulfillment-change-label="{{ 'sections.cart.fulfillment_change' | t }}"
              >
                {%- if fulfillment_method != blank -%}
                  {{ 'sections.cart.fulfillment_change' | t }}
                {%- else -%}
                  {{ 'sections.cart.fulfillment_choose' | t }}
                {%- endif -%}
              </button>
            </div>

            <noscript>
              <div class="fulfillment-summary__nojs">
                <form action="{{ routes.cart_url }}" method="post">
                  <input type="hidden" name="attributes[Fulfillment method]" value="Pickup">
                  <button type="submit" class="btn btn--secondary">
                    {{ 'sections.cart.fulfillment_set_pickup' | t }}
                  </button>
                </form>
                <form action="{{ routes.cart_url }}" method="post">
                  <input type="hidden" name="attributes[Fulfillment method]" value="Delivery">
                  <button type="submit" class="btn btn--secondary">
                    {{ 'sections.cart.fulfillment_set_delivery' | t }}
                  </button>
                </form>
              </div>
            </noscript>
          </div>

          <div class="cart-summary">
            <p class="cart-summary__heading label">{{ 'sections.cart.order_summary' | t }}</p>

            <div class="cart-summary__row">
              <span>{{ 'sections.cart.subtotal' | t }}</span>
              <span>{{ cart.total_price | money }}</span>
            </div>
            <div class="cart-summary__row">
              <span>{{ 'sections.cart.delivery' | t }}</span>
              <span>
                {%- if fulfillment_method == 'Pickup' -%}
                  {{ 'sections.cart.delivery_pickup' | t }}
                {%- else -%}
                  {{ 'sections.cart.calculated_at_checkout' | t }}
                {%- endif -%}
              </span>
            </div>
            <div class="cart-summary__row">
              <span>{{ 'sections.cart.taxes' | t }}</span>
              <span>
                {%- if cart.taxes_included -%}
                  {{ 'sections.cart.taxes_included' | t }}
                {%- else -%}
                  {{ 'sections.cart.calculated_at_checkout' | t }}
                {%- endif -%}
              </span>
            </div>
            <div class="cart-summary__row cart-summary__row--total">
              <span>{{ 'sections.cart.estimated_total' | t }}</span>
              <span>{{ cart.total_price | money }}</span>
            </div>
            <p class="cart-summary__total-note text-small">{{ 'sections.cart.total_note' | t }}</p>

            <button
              type="submit"
              name="checkout"
              class="btn btn--primary cart-summary__checkout"
              data-cart-checkout
            >
              {{ 'sections.cart.checkout' | t }}
            </button>

            {%- if additional_checkout_buttons -%}
              <p class="cart-summary__accelerated-label text-small">{{ 'sections.cart.pay_faster' | t }}</p>
              <div class="cart-summary__accelerated-buttons">
                {{ content_for_additional_checkout_buttons }}
              </div>
            {%- endif -%}

            <p class="cart-summary__trust text-small">{{ 'sections.cart.trust_note' | t }}</p>
          </div>

          <a href="{{ routes.root_url }}#box-selector" class="btn btn--text cart-page__continue">
            {{ 'sections.cart.add_another' | t }}
          </a>
        </div>
      </div>
    </form>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Main cart",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "REVIEW YOUR ORDER"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "YOUR BAG"
    },
    {
      "type": "header",
      "content": "Color"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "cream", "label": "Cream / Near black text" },
        { "value": "mango", "label": "Mango / Near black text" },
        { "value": "black", "label": "Near black / Cream text" },
        { "value": "chrome", "label": "Chrome / Near black text" }
      ],
      "default": "cream"
    }
  ]
}
{% endschema %}
