{% comment %} Flavor Banners Section — alternating image/text layout with hover color effect {% endcomment %}

<div class="flavor-banners">
  {% for block in section.blocks %}
    {% assign is_even = forloop.index0 | modulo: 2 %}
    {% assign banner_class = 'flavor-banner--img-left' %}
    {% if is_even == 0 %}{% assign banner_class = 'flavor-banner--img-right' %}{% endif %}
    <div class="flavor-banner {{ banner_class }}"
         style="--flavor-bg: {{ block.settings.bg_color }}; --flavor-text: {{ block.settings.text_color }};"
         {{ block.shopify_attributes }}>

      <div class="flavor-banner__content">
        <h2 class="flavor-banner__title">
          {{ block.settings.title }}
        </h2>
        <p class="flavor-banner__desc">
          {{ block.settings.description }}
        </p>
        <div class="flavor-banner__buttons">
          {% if block.settings.btn1_label != blank %}
            <a href="{{ block.settings.btn1_url }}" class="flavor-banner__btn flavor-banner__btn--outline">
              {{ block.settings.btn1_label }}
            </a>
          {% endif %}
          {% if block.settings.btn2_label != blank %}
            <a href="#shopify-section-template--30037460779343__box-selector" class="flavor-banner__btn flavor-banner__btn--filled">
              {{ block.settings.btn2_label }}
            </a>
          {% endif %}
        </div>
      </div>

      {% if block.settings.image != blank %}
        <div class="flavor-banner__image-wrap">
          {{ block.settings.image | image_url: width: 600 | image_tag: class: 'flavor-banner__image', loading: 'lazy' }}
        </div>
      {% endif %}

    </div>
  {% endfor %}
</div>

<style>
  .flavor-banners {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding: 2rem 1rem;
    max-width: 1100px;
    margin: 0 auto;
  }

  .flavor-banner {
    display: flex;
    align-items: center;
    border-radius: 24px;
    overflow: visible;
    padding: 3rem 3.5rem;
    position: relative;
    gap: 2rem;
    min-height: 260px;
    background-color: #FFFFFF;
    color: #1A1A1A;
    transition: background-color 0.25s ease, color 0.25s ease;
    cursor: default;
  }

  .flavor-banner:hover {
    background-color: var(--flavor-bg);
    color: var(--flavor-text);
  }

  .flavor-banner--img-right { flex-direction: row; }
  .flavor-banner--img-left  { flex-direction: row-reverse; }

  .flavor-banner__content {
    flex: 1;
  }

  .flavor-banner__title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 900;
    margin: 0 0 0.5rem;
    line-height: 1.1;
    color: inherit;
    transition: color 0.25s ease;
  }

  .flavor-banner__desc {
    font-size: 1rem;
    margin: 0 0 1.5rem;
    max-width: 480px;
    opacity: 0.9;
    color: inherit;
    transition: color 0.25s ease;
  }

  .flavor-banner__buttons {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .flavor-banner__btn {
    padding: 0.65rem 1.4rem;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .flavor-banner__btn:hover { opacity: 0.8; }

  .flavor-banner__btn--outline {
    border: 2px solid currentColor;
    background: transparent;
    color: inherit;
  }

  .flavor-banner__btn--filled {
    background-color: #1A1A1A;
    color: #FFFFFF;
    border: 2px solid #1A1A1A;
  }

  .flavor-banner:hover .flavor-banner__btn--filled {
    background-color: var(--flavor-text);
    color: var(--flavor-bg);
    border-color: var(--flavor-text);
  }

  .flavor-banner__image-wrap {
    flex: 0 0 280px;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    margin-top: -2rem;
    margin-bottom: -2rem;
  }

  .flavor-banner__image {
    width: 280px;
    height: 280px;
    object-fit: cover;
    border-radius: 50%;
    display: block;
  }

  @media (max-width: 700px) {
    .flavor-banner,
    .flavor-banner--img-left {
      flex-direction: column !important;
      padding: 2rem 1.5rem;
      text-align: center;
    }
    .flavor-banner__image-wrap {
      margin: 0;
    }
    .flavor-banner__buttons { justify-content: center; }
  }
</style>

{% schema %}
{
  "name": "Flavor Banners",
  "blocks": [
    {
      "type": "flavor",
      "name": "Flavor",
      "settings": [
        { "type": "text",         "id": "title",       "label": "Titel",            "default": "Cookie Name" },
        { "type": "textarea",     "id": "description", "label": "Beschreibung",     "default": "Kurze Beschreibung..." },
        { "type": "color",        "id": "bg_color",    "label": "Hintergrundfarbe", "default": "#6B3B2A" },
        { "type": "color",        "id": "text_color",  "label": "Textfarbe",        "default": "#FFFFFF" },
        { "type": "image_picker", "id": "image",       "label": "Cookie Bild" },
        { "type": "text",         "id": "btn1_label",  "label": "Button 1 Text",    "default": "Learn More" },
        { "type": "url",          "id": "btn1_url",    "label": "Button 1 Link" },
        { "type": "text",         "id": "btn2_label",  "label": "Button 2 Text",    "default": "Order Now" }
      ]
    }
  ],
  "presets": [
    { "name": "Flavor Banners" }
  ]
}
{% endschema %}
