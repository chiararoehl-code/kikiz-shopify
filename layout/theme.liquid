<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    {%- style -%}
      {{ settings.font_display | font_face: font_display: 'swap' }}
      {{ settings.font_body | font_face: font_display: 'swap' }}

      :root {
        /* Raw brand swatches — Mango x Chrome x Cream x Near Black */
        --color-mango: {{ settings.color_mango }};
        --color-mango-deep: {{ settings.color_mango_deep }};
        --color-cream: {{ settings.color_cream }};
        --color-black: {{ settings.color_black }};
        --color-surface: {{ settings.color_surface }};
        --color-concrete: {{ settings.color_concrete }};
        --color-concrete-light: {{ settings.color_concrete_light }};

        /* Semantic roles, derived centrally so no section invents its own hex */
        --color-brand-primary: var(--color-mango);
        --color-brand-dark: var(--color-mango-deep);
        --color-ink: var(--color-black);
        --color-background: var(--color-cream);
        --color-text: var(--color-black);
        --color-muted: var(--color-concrete);
        --color-border: var(--color-concrete-light);

        /* Restrained brushed-steel gradient — warm greys, no blue/holographic cast */
        --metal-1: #EEEBE3;
        --metal-2: #C9C6BB;
        --metal-3: #DEDBD1;
        --metal-4: #AFAB9F;
        --metal-5: #E3E0D6;

        --font-display: {{ settings.font_display.family | default: 'Helvetica Neue' }}, {{ settings.font_display.fallback_families | default: 'Arial, sans-serif' }}, sans-serif;
        --font-body: {{ settings.font_body.family | default: 'Helvetica Neue' }}, {{ settings.font_body.fallback_families | default: 'Arial, sans-serif' }}, sans-serif;
        --page-width: {{ settings.page_width }}px;
      }
    {%- endstyle -%}

    {{ 'theme.css' | asset_url | stylesheet_tag }}

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name }}" data-fulfillment-method="{{ cart.attributes['Fulfillment method'] | escape }}">
    <a class="visually-hidden skip-to-content-link" href="#MainContent">
      {{ 'general.accessibility.skip_to_content' | t }}
    </a>

    {% section 'header' %}

    <main id="MainContent" class="main-content">
      {{ content_for_layout }}
    </main>

    {% section 'footer' %}

    {%- render 'fulfillment-chooser' -%}

    {{ 'theme.js' | asset_url | script_tag }}
    {{ 'product-form.js' | asset_url | script_tag }}
    {{ 'box-builder.js' | asset_url | script_tag }}
    {{ 'post-add-flow.js' | asset_url | script_tag }}
    {{ 'fulfillment.js' | asset_url | script_tag }}
  </body>
</html>
