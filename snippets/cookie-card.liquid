{%- comment -%}
  Large, visual, display-only flavor card for discovery contexts (Weekly Drop).
  No quantity controls, no price, no add-to-cart — pure brand/product presentation.
  For the compact picker used inside the box builder, see flavor-selector.liquid.
  Accepts:
    flavor (cookie_flavor metaobject, required)
    featured (boolean, optional) — larger, Mango-bordered treatment for the
      weekly special. Same card, different frame — no second component.

  `image` is a file_reference field. Runtime debug against a real
  metaobject entry confirmed flavor.image.reference is blank/invalid on
  this theme, while flavor.image.value resolves directly to the Image
  and pipes into image_url correctly. Use .value, not .reference.
{%- endcomment -%}

{%- liquid
  assign flavor_image = flavor.image.value
  assign flavor_image_url = flavor_image | image_url: width: 800
-%}

<article class="cookie-card{% if featured %} cookie-card--featured{% endif %}">
  <div class="cookie-card__media shape-rounded">
    {%- if flavor_image_url != blank -%}
      <img
        class="cookie-card__image"
        src="{{ flavor_image_url }}"
        srcset="
          {{ flavor_image | image_url: width: 500 }} 500w,
          {{ flavor_image | image_url: width: 800 }} 800w,
          {{ flavor_image | image_url: width: 1100 }} 1100w
        "
        sizes="(min-width: 990px) 30vw, (min-width: 750px) 46vw, 82vw"
        width="{{ flavor_image.width }}"
        height="{{ flavor_image.height }}"
        alt="{{ flavor_image.alt | default: flavor.name.value | escape }}"
        loading="lazy"
      >
    {%- else -%}
      <div class="cookie-card__media-placeholder" aria-hidden="true">
        <span class="cookie-card__placeholder-mark"></span>
      </div>
    {%- endif -%}

    {%- if flavor.badge.value != blank -%}
      {%- render 'badge', text: flavor.badge.value, style: 'accent' -%}
    {%- endif -%}
  </div>

  <div class="cookie-card__content">
    <h3 class="cookie-card__title h3">{{ flavor.name.value }}</h3>
    {%- if flavor.short_description.value != blank -%}
      <p class="cookie-card__description text-small">{{ flavor.short_description.value }}</p>
    {%- endif -%}
  </div>
</article>
