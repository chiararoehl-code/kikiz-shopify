{%- comment -%}
  Renders a small printed-label style badge.
  Accepts:
    text (string, required)
    style (string, optional) — "accent" (default) or "sold-out"
{%- endcomment -%}

{%- if text != blank -%}
  <span class="badge badge--{{ style | default: 'accent' }}">
    <span class="badge__text">{{ text }}</span>
  </span>
{%- endif -%}
