{%- comment -%}
  Compact flavor picker used only inside the box builder modal. Optimized for
  fast selection, not brand presentation — see cookie-card.liquid for that.
  Accepts:
    flavor (cookie_flavor metaobject, required)

  See cookie-card.liquid for why this reads .value, not .reference:
  runtime debug confirmed flavor.image.reference is blank/invalid on this
  theme, while flavor.image.value resolves directly to the Image.

  data-flavor-key must be unique per row — box-builder.js keys its
  selections state on it. flavor.handle rendered the same value for every
  row in this runtime (confirmed: one click bumped every flavor's display
  to the same quantity), so this uses flavor.id, which is always present
  and unique for any Liquid object, instead.
{%- endcomment -%}

{%- liquid
  assign flavor_image_url = flavor.image.value | image_url: width: 80
-%}

<div
  class="flavor-selector"
  data-flavor-select-item
  data-flavor-key="{{ flavor.id }}"
  data-flavor-name="{{ flavor.name.value | escape }}"
>
  <button
    type="button"
    class="flavor-selector__pill"
    data-flavor-add
    aria-label="{{ 'box_builder.flavor.add_accessible' | t: flavor: flavor.name.value }}"
  >
    {%- if flavor_image_url != blank -%}
      <span class="flavor-selector__thumb">
        <img
          src="{{ flavor_image_url }}"
          width="40"
          height="40"
          alt=""
          loading="lazy"
        >
      </span>
    {%- else -%}
      <span class="flavor-selector__thumb flavor-selector__thumb--placeholder" aria-hidden="true"></span>
    {%- endif -%}
    <span class="flavor-selector__name">{{ flavor.name.value }}</span>
    {%- if flavor.badge.value != blank -%}
      {%- render 'badge', text: flavor.badge.value, style: 'accent' -%}
    {%- endif -%}
  </button>

  <div class="flavor-selector__stepper" data-flavor-stepper hidden>
    <span class="flavor-selector__stepper-name">{{ flavor.name.value }}</span>
    <button
      type="button"
      class="flavor-selector__step-btn"
      data-flavor-minus
      aria-label="{{ 'box_builder.flavor.remove_accessible' | t: flavor: flavor.name.value }}"
    >&minus;</button>
    <span class="flavor-selector__qty" data-flavor-qty aria-live="polite">0</span>
    <button
      type="button"
      class="flavor-selector__step-btn"
      data-flavor-plus
      aria-label="{{ 'box_builder.flavor.add_more_accessible' | t: flavor: flavor.name.value }}"
    >+</button>
  </div>
</div>
