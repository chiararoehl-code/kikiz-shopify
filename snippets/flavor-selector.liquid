{%- comment -%}
  Compact flavor picker used only inside the box builder modal. Optimized for
  fast selection, not brand presentation — see cookie-card.liquid for that.
  Accepts:
    flavor (cookie_flavor metaobject, required)

  See cookie-card.liquid for why this reads .value, not .reference:
  runtime debug confirmed flavor.image.reference is blank/invalid on this
  theme, while flavor.image.value resolves directly to the Image.

  data-flavor-key must be unique per row — box-builder.js keys its
  selections state on it. Runtime debug confirmed both flavor.handle and
  flavor.id render blank for this metaobject in this theme, so this uses
  flavor.system.handle, the Metaobject system's own stable per-entry
  handle. flavor.name.value | handleize is a defensive fallback only, in
  case system.handle is ever unexpectedly blank.

  One visual row per flavor: the thumbnail and name stay in place, and only
  the trailing control swaps between the add button and the stepper — both
  still toggled via the same [data-flavor-add]/[data-flavor-stepper] hidden
  attributes box-builder.js already sets, so box-builder.js needs no change
  for this layout. Selected styling (border/background) is driven by CSS
  :has() against [data-flavor-stepper]:not([hidden]), not by a JS-added
  class.
{%- endcomment -%}

{%- liquid
  assign flavor_image_url = flavor.image.value | image_url: width: 160
  assign flavor_key = flavor.system.handle
  if flavor_key == blank
    assign flavor_key = flavor.name.value | handleize
  endif
-%}

<div
  class="flavor-row"
  data-flavor-select-item
  data-flavor-key="{{ flavor_key | escape }}"
  data-flavor-name="{{ flavor.name.value | escape }}"
>
  <span class="flavor-row__thumb">
    {%- if flavor_image_url != blank -%}
      <img
        src="{{ flavor_image_url }}"
        width="72"
        height="72"
        alt=""
        loading="lazy"
      >
    {%- else -%}
      <span class="flavor-row__thumb-placeholder" aria-hidden="true"></span>
    {%- endif -%}
  </span>

  <span class="flavor-row__name">{{ flavor.name.value }}</span>

  {%- if flavor.badge.value != blank -%}
    {%- render 'badge', text: flavor.badge.value, style: 'accent' -%}
  {%- endif -%}

  <button
    type="button"
    class="flavor-row__add"
    data-flavor-add
    aria-label="{{ 'box_builder.flavor.add_accessible' | t: flavor: flavor.name.value }}"
  >+</button>

  <div class="flavor-row__stepper" data-flavor-stepper hidden>
    <button
      type="button"
      class="flavor-row__step-btn"
      data-flavor-minus
      aria-label="{{ 'box_builder.flavor.remove_accessible' | t: flavor: flavor.name.value }}"
    >&minus;</button>
    <span class="flavor-row__qty" data-flavor-qty aria-live="polite">0</span>
    <button
      type="button"
      class="flavor-row__step-btn"
      data-flavor-plus
      aria-label="{{ 'box_builder.flavor.add_more_accessible' | t: flavor: flavor.name.value }}"
    >+</button>
  </div>
</div>
